      "react": "$react",
      "react-dom": "$react-dom",
      "@types/react": "$@types/react"
    },
    "@material-ui/utils": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@types/react": "$@types/react"
    },
    "prismjs": "1.30.0",
    "@material-ui/pickers": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@types/react": "$@types/react"
    }
